{{!-- Feat item sheet — spec section 4b. Must render one top-level element. --}}
<div class="kd20-sheet kd20-item-sheet{{#if system.dormant}} kd20-dormant{{/if}}">

  <header class="kd20-header">
    <img class="kd20-portrait small" src="{{document.img}}" alt="{{document.name}}"
         data-action="editImage" data-edit="img">
    <input class="kd20-name" type="text" name="name" value="{{document.name}}"
           placeholder="Feat name" {{#unless editable}}disabled{{/unless}}>
  </header>

  <section class="kd20-block">
    <h2>Feat</h2>
    <div class="kd20-derived">
      <div class="kd20-field">
        <label for="feat-type">Type</label>
        <select id="feat-type" name="system.featType" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions choices.featTypes selected=system.featType}}
        </select>
      </div>
      <div class="kd20-field">
        <label for="cost-xp">XP Cost</label>
        <input id="cost-xp" type="number" step="1" name="system.costXp"
               value="{{system.costXp}}" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="kd20-field kd20-check">
        <label for="spec-die">Grants Specialization Die</label>
        <input id="spec-die" type="checkbox" name="system.grantsSpecializationDie"
               {{checked system.grantsSpecializationDie}} {{#unless editable}}disabled{{/unless}}>
      </div>
    </div>
    <p class="kd20-hint">
      A Specialization Die is one d6, added only when this feat applies. At most one
      per roll. Master feat die-stacking is out of scope for v1.
    </p>
  </section>

  {{!--
    Devotion feats (KD20_Feats.md): deity + Vow, and the GM's dormant toggle for
    the Breach Ladder's "lapse". Display only — nothing is automated. This
    section stays at full strength while the rest of a dormant feat greys out.
  --}}
  <section class="kd20-block kd20-devotion">
    <h2>Devotion</h2>
    {{#if system.dormant}}
    <p class="kd20-dormant-banner">
      <strong>Dormant</strong> — faith is broken. This feat does not function until atonement.
    </p>
    {{/if}}
    <div class="kd20-derived">
      <div class="kd20-field">
        <label for="deity">Deity</label>
        <input id="deity" type="text" name="system.deity" value="{{system.deity}}"
               placeholder="blank = not a Devotion feat" {{#unless editable}}disabled{{/unless}}>
      </div>
      <div class="kd20-field kd20-check">
        <label for="dormant">Dormant</label>
        <input id="dormant" type="checkbox" name="system.dormant"
               {{checked system.dormant}} {{#unless editable}}disabled{{/unless}}>
      </div>
    </div>
    <div class="kd20-field">
      <label for="vow">Vow</label>
      <input id="vow" type="text" name="system.vow" value="{{system.vow}}"
             placeholder="e.g. marked by Kael, exclusive worship" {{#unless editable}}disabled{{/unless}}>
    </div>
    <p class="kd20-hint">
      The GM ticks Dormant when the devotee breaks faith (a lapse) and clears it on atonement.
    </p>
  </section>

  {{!--
    Core rules v0.37/v0.39: the few feats whose flat, always-on effect the
    character sheet computes. Each owned copy is one purchase.
  --}}
  <section class="kd20-block">
    <h2>Computed Effect</h2>
    <div class="kd20-derived">
      <div class="kd20-field">
        <label for="mechanic-kind">Mechanic</label>
        <select id="mechanic-kind" name="system.mechanic.kind" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions choices.featMechanics selected=system.mechanic.kind}}
        </select>
      </div>
      {{#if (eq system.mechanic.kind "hardenedSave")}}
      <div class="kd20-field">
        <label for="mechanic-save">Save raised</label>
        <select id="mechanic-save" name="system.mechanic.save" {{#unless editable}}disabled{{/unless}}>
          {{selectOptions choices.saves selected=system.mechanic.save}}
        </select>
      </div>
      {{/if}}
    </div>
    {{#if (eq system.mechanic.kind "hardenedSave")}}
    <p class="kd20-hint">
      Each copy raises the chosen Save one ladder step (−3 → 0 → +1 → +3 → +5). Major +5
      only on a gateway-Solid Save; a −3 lifts only to 0. Cost by step: 20 / 20 / 30 / 40 XP.
    </p>
    {{else if (eq system.mechanic.kind "armourTraining")}}
    <p class="kd20-hint">+1 AC per copy (max +2) while armour heavier than light is worn.</p>
    {{else if (eq system.mechanic.kind "unarmoredDefense")}}
    <p class="kd20-hint">
      While light or no armour is worn, AC = 10 + dex + your gateway's themed stat + shield + misc.
      The gateway names the stat.
    </p>
    {{/if}}
  </section>

  <section class="kd20-block">
    <h2>Trigger</h2>
    <p class="kd20-hint">When this feat's die or effect applies. The GM and player decide in v1.</p>
    <input type="text" name="system.trigger" value="{{system.trigger}}"
           placeholder="e.g. when attacking with a blade"
           {{#unless editable}}disabled{{/unless}}>
  </section>

  <section class="kd20-block">
    <h2>Prerequisite</h2>
    <input type="text" name="system.prerequisite" value="{{system.prerequisite}}"
           placeholder="Display only in v1" {{#unless editable}}disabled{{/unless}}>
  </section>

  <section class="kd20-block">
    <h2>Effect</h2>
    {{formInput systemFields.effect value=system.effect enriched=enriched.effect
                toggled=true compact=true disabled=disabled classes="content-sized"}}
  </section>

  <section class="kd20-block">
    <h2>Description</h2>
    {{formInput systemFields.description value=system.description enriched=enriched.description
                toggled=true compact=true disabled=disabled classes="content-sized"}}
  </section>

</div>
